# Provider configuration — optional; anything set here seeds the UI and acts as
# fallback when the UI has not set a key. UI-set keys (in-memory) override these.
# All are OpenAI-compatible endpoints (base_url = the /v1 base).

# LLM (chat) provider
LLM_PROVIDER_NAME=
LLM_PROVIDER_BASE_URL=
LLM_PROVIDER_MODEL_NAME=
LLM_PROVIDER_API_KEY=

# Embeddings provider
EMBEDDING_PROVIDER_NAME=
EMBEDDING_PROVIDER_BASE_URL=
EMBEDDING_PROVIDER_MODEL_NAME=
EMBEDDING_PROVIDER_API_KEY=
